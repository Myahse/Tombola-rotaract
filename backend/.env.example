DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=
SESSION_SECRET=generate-a-long-random-string
PORT=3001
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177
PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3001
CAMPAIGN_SITE_URL=http://localhost:5175
EXAM_SITE_URL=http://localhost:5177
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Rotaract IUGB Club
WAVE_PAY_URL=https://pay.wave.com/m/M_ci_pHlyZFYyH1Su/c/ci/

# Rate limits (optional — production defaults are higher than local dev)
# RATE_LIMIT_WINDOW_MINUTES=15
# RATE_LIMIT_REGISTER_PER_IP=30
# RATE_LIMIT_REGISTER_PER_EMAIL=5
# RATE_LIMIT_REGISTER_EMAIL_MINUTES=60
# RATE_LIMIT_LOGIN_PER_IP=30
# RATE_LIMIT_BUY_PER_IP=50
# RATE_LIMIT_CANCEL_PER_IP=20

# Optional: paste HTML into Brevo transactional templates, then set the IDs here.
# BREVO_TEMPLATE_WINNER is the single post-draw email (all prizes in one message).
BREVO_TEMPLATE_WELCOME=
BREVO_TEMPLATE_WINNER=
BREVO_TEMPLATE_PURCHASE=

# Web Push (generate with: npx web-push generate-vapid-keys)
# Required in production. Locally, ephemeral keys are created if these are empty.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional. mailto: or https:// URL used as the VAPID subject.
# VAPID_SUBJECT=https://tombola.rotaractiugb.com

# Production (Vercel) — set these in the API project env, not here:
# CORS_ORIGIN=https://tombola.rotaractiugb.com,https://organisateurs.rotaractiugb.com,https://campagnes.rotaractiugb.com,https://exam.rotaractiugb.com,https://monitor.rotaractiugb.com
