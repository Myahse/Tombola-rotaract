DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=
SESSION_SECRET=generate-a-long-random-string
REDIS_URL=
# Upstash or Redis Cloud. Used to blacklist revoked access tokens until they expire.
# Locally the API falls back to an in-memory list if this is empty.
PORT=3001
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175
PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3001
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Rotaract IUGB Club
WAVE_PAY_URL=https://pay.wave.com/m/M_ci_pHlyZFYyH1Su/c/ci/
# Optional: paste HTML into Brevo transactional templates, then set the IDs here.
# BREVO_TEMPLATE_WINNER is the single post-draw email (all prizes in one message).
BREVO_TEMPLATE_WELCOME=
BREVO_TEMPLATE_WINNER=
BREVO_TEMPLATE_PURCHASE=

# Web Push (generate with: npx web-push generate-vapid-keys)
# Required in production. Locally, ephemeral keys are created if these are empty.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional. mailto: or https:// URL used as the VAPID subject.
# VAPID_SUBJECT=https://tombola.rotaractiugb.com

# Production (Vercel) — set these in the API project env, not here:
# CORS_ORIGIN=https://tombola.rotaractiugb.com,https://organisateurs.rotaractiugb.com,https://campagnes.rotaractiugb.com
# PUBLIC_SITE_URL=https://tombola.rotaractiugb.com
